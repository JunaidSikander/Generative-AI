# ============================================================
#  ENVIRONMENT VARIABLES — TEMPLATE
# ============================================================
#
#  HOW TO USE THIS FILE
#  --------------------
#  1. Make a copy of this file and name the copy ".env"
#       Windows (PowerShell):  Copy-Item .env.example .env
#       macOS / Linux:         cp .env.example .env
#
#  2. Open ".env" and paste your real keys after the "=" signs.
#
#  3. NEVER commit ".env" to Git. It is already listed in
#     .gitignore, so Git will ignore it automatically.
#     This file (.env.example) is safe to commit because it
#     contains no real keys — only placeholders.
#
#  You do NOT need every key below. Each module tells you which
#  ones it uses. Leave the rest blank.
# ============================================================


# ------------------------------------------------------------
# OpenAI  —  used as the primary provider in most labs
# Get a key: https://platform.openai.com/api-keys
# Billing:   https://platform.openai.com/usage
# ------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------
# Anthropic (Claude)  —  optional alternative provider
# Get a key: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Google Gemini  —  optional; has a generous free tier
# Get a key: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GOOGLE_API_KEY=

# ------------------------------------------------------------
# Hugging Face  —  needed to download some gated models
# Get a token: https://huggingface.co/settings/tokens
# ------------------------------------------------------------
HUGGINGFACEHUB_API_TOKEN=

# ------------------------------------------------------------
# Ollama  —  the FREE local fallback used throughout the course.
# No key needed. This is just the address Ollama listens on.
# Only change it if you moved Ollama off its default port.
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# Optional extras (only a few labs use these)
# ------------------------------------------------------------
# Pinecone — hosted vector database (Module 7)
PINECONE_API_KEY=

# Tavily — web search tool for agents (Module 9)
TAVILY_API_KEY=

# LangSmith — tracing and debugging for chains (Modules 6, 11)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=genai-from-scratch
